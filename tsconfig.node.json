{
  "compilerOptions": {
    "target": "ES2023",
    // Playwright evaluate() callbacks run in the page, so DOM types are needed here.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e", "scripts"]
}
