{
  "name": "copernicus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Copernicus website redesign: accessible Next.js front-end conforming to WCAG 2.2 AA, with a documented path to AAA.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/prepare-standalone.mjs && node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "playwright test",
    "test:a11y:ui": "playwright test --ui",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:boundary": "node scripts/check-client-boundary.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "design:inventory": "node scripts/generate-component-inventory.mjs",
    "design:inventory:check": "node scripts/generate-component-inventory.mjs --check",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run check:contrast && pnpm run check:boundary && pnpm run check:structure && pnpm run design:inventory:check && pnpm run test && pnpm run build && pnpm run typecheck"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
