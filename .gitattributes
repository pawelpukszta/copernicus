# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Lockfile: keep diffs collapsed in reviews
pnpm-lock.yaml linguist-generated=true -diff
